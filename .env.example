# Copy to .env and adjust. .env is git-ignored.

# Nominatim usage policy: identify your application, ideally with contact info.
# Example: qgis-property-report/0.2 (contact: you@example.com)
OSM_USER_AGENT=qgis-property-report/0.2 (PyQGIS location report demo)

# Local OSM extract inside the container (default set in docker-compose.yml).
# Download it with scripts/download_extract.ps1 into ./data on the host.
# OSM_PBF_PATH=/data/turkey-latest.osm.pbf

# --- AI location summary (any OpenAI-compatible chat-completions API) ---
# Default: Groq. Switching provider only requires changing these values.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Example (not tested in this project yet):
# LLM_PROVIDER=openrouter
# LLM_MODEL=<model id>
# LLM_BASE_URL=https://openrouter.ai/api/v1
