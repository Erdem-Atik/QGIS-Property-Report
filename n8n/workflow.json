      "id": "a1f0c6e2-0006-4c1a-9a01-000000000006",
      "name": "Download PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "onError": "continueErrorOutput",
      "position": [880, -200]
    },
    {
      "parameters": {
        "jsCode": "// Give the attachment a readable name instead of report.pdf.\nconst req = $('Webhook').first().json.body;\nconst label = String(req.name || req.address || `${req.lat}, ${req.lon}`)\n  .replace(/[\\\\/:*?\"<>|]+/g, ' ').replace(/\\s+/g, ' ').trim().slice(0, 80);\nconst item = $input.first();\nitem.binary.data.fileName = `Location Report - ${label}.pdf`;\nitem.json.label = label;\nreturn [item];"
      },
      "id": "a1f0c6e2-0011-4c1a-9a01-000000000011",
      "name": "Name Attachment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "onError": "continueErrorOutput",
      "position": [1100, -200]
    },
    {
      "parameters": {
        "sendTo": "={{ String($('Webhook').item.json.body.email).trim() }}",
        "subject": "={{ 'Location report: ' + $json.label }}",
        "emailType": "text",
        "message": "={{ 'Hello,\\n\\nPlease find attached the location report for ' + $json.label + '.\\n\\nThe report shows nearby amenities within 500 m and 1 km, straight-line distances to the nearest place in each category, and a short location summary.\\n\\nCoverage: Türkiye only. Map data © OpenStreetMap contributors.\\n\\nReport ID: ' + $('Generate Report').item.json.body.job }}",
        "options": {
          "appendAttribution": false,
          "attachmentsUi": {
            "attachmentsBinary": [
              {
                "property": "data"
              }
            ]
          }
        }
      },
      "id": "a1f0c6e2-0007-4c1a-9a01-000000000007",
      "name": "Send Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "onError": "continueErrorOutput",
      "position": [1320, -200],
      "webhookId": "c7d1e2f3-property-report-gmail"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ...$('Generate Report').item.json.body, email_sent_to: String($('Webhook').item.json.body.email).trim(), email_message_id: $json.id } }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "a1f0c6e2-0004-4c1a-9a01-000000000004",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1540, -300]
    },
